# WireGuard Full Mesh HA Inventory - auto-generated by Terraform
# Do not edit manually. Terraform rewrites this file during apply.

[gcp_control_plane]
%{ for i, node in control_plane_nodes ~}
${node.name} ansible_host=${node.public_ip} wireguard_ip=10.0.0.${i + 1} wireguard_endpoint=${node.public_ip} cloud=gcp
%{ endfor ~}

[aws_workers]
%{ for i, node in worker_nodes ~}
${node.name} ansible_host=${node.public_ip != null && node.public_ip != "" ? node.public_ip : node.private_ip} wireguard_ip=10.0.0.${length(control_plane_nodes) + i + 1} wireguard_endpoint=${node.public_ip != null && node.public_ip != "" ? node.public_ip : node.private_ip} cloud=aws
%{ endfor ~}

[wireguard:children]
gcp_control_plane
aws_workers

[all:vars]
ansible_user=${ansible_user}
ansible_ssh_private_key_file=${ansible_ssh_private_key_file}
ansible_python_interpreter=${ansible_python_interpreter}
ansible_ssh_extra_args='${ansible_ssh_extra_args}'
wireguard_interface=wg0
wireguard_port=51820
wireguard_network=10.0.0.0/24
wireguard_mask=24
wireguard_persistent_keepalive=25
