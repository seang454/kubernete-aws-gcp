# Kubespray HA inventory - auto-generated by Terraform
# Hybrid Cloud Topology: Control Plane on GCP + Worker Nodes on AWS
# Do not edit manually. Terraform rewrites this file during apply.

[kube_control_plane]
%{ for i, node in control_plane_nodes ~}
${node.name} ansible_host=${node.public_ip} ip=${use_wireguard_ip ? "10.0.0.${i + 1}" : node.private_ip}%{ if use_wireguard_ip } access_ip=10.0.0.${i + 1}%{ else }%{ if use_public_access_ip } access_ip=${node.public_ip}%{ endif }%{ endif } etcd_member_name=${node.etcd_member_name}
%{ endfor ~}

[etcd:children]
kube_control_plane

[kube_node]
%{ for i, node in worker_nodes ~}
${node.name} ansible_host=${node.public_ip != null && node.public_ip != "" ? node.public_ip : node.private_ip} ip=${use_wireguard_ip ? "10.0.0.${length(control_plane_nodes) + i + 1}" : node.private_ip}%{ if use_wireguard_ip } access_ip=10.0.0.${length(control_plane_nodes) + i + 1}%{ else }%{ if use_public_access_ip } access_ip=${node.public_ip != null && node.public_ip != "" ? node.public_ip : node.private_ip}%{ endif }%{ endif }
%{ endfor ~}

[k8s_cluster:children]
kube_control_plane
kube_node

[calico_rr]

[all:vars]
ansible_user=${ansible_user}
ansible_ssh_private_key_file=${ansible_ssh_private_key_file}
ansible_python_interpreter=${ansible_python_interpreter}
ansible_ssh_extra_args='${ansible_ssh_extra_args}'
