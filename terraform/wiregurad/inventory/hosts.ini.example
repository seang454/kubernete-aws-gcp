# WireGuard Full Mesh HA Inventory - Example (Terraform auto-generates inventory/hosts.ini)
# Do not edit manually. Terraform rewrites this file during apply.

[gcp_control_plane]
master01 ansible_host=34.120.100.80 wireguard_ip=10.0.0.1 wireguard_endpoint=34.120.100.80 cloud=gcp
master02 ansible_host=34.120.100.81 wireguard_ip=10.0.0.2 wireguard_endpoint=34.120.100.81 cloud=gcp
master03 ansible_host=34.120.100.82 wireguard_ip=10.0.0.3 wireguard_endpoint=34.120.100.82 cloud=gcp

[aws_workers]
worker01 ansible_host=16.170.200.50 wireguard_ip=10.0.0.4 wireguard_endpoint=16.170.200.50 cloud=aws
worker02 ansible_host=16.170.200.51 wireguard_ip=10.0.0.5 wireguard_endpoint=16.170.200.51 cloud=aws
worker03 ansible_host=16.170.200.52 wireguard_ip=10.0.0.6 wireguard_endpoint=16.170.200.52 cloud=aws
worker04 ansible_host=16.170.200.53 wireguard_ip=10.0.0.7 wireguard_endpoint=16.170.200.53 cloud=aws

[wireguard:children]
gcp_control_plane
aws_workers

[all:vars]
ansible_user=seang
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_extra_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
wireguard_interface=wg0
wireguard_port=51820
wireguard_network=10.0.0.0/24
wireguard_mask=24
wireguard_persistent_keepalive=25
