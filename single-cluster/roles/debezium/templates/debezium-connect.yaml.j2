---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ debezium_plugins_pvc_name | default('debezium-plugins-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ default_storage_class | default('longhorn') }}
  resources:
    requests:
      storage: {{ debezium_plugins_storage_size | default('5Gi') }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ debezium_data_pvc_name | default('debezium-data-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ default_storage_class | default('longhorn') }}
  resources:
    requests:
      storage: {{ debezium_data_storage_size | default('5Gi') }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
spec:
  type: ClusterIP
  ports:
    - port: {{ debezium_port | default(8083) }}
      targetPort: {{ debezium_port | default(8083) }}
      name: http
  selector:
    app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ debezium_service_name | default('debezium-kafka-connect-itp') }}
    spec:
      containers:
        - name: debezium-connect
          image: {{ debezium_image | default('quay.io/debezium/connect:3.4.0.Final') }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ debezium_port | default(8083) }}
              name: http
          env:
            - name: GROUP_ID
              value: "{{ debezium_group_id | default('cdc_connect-group') }}"
            - name: BOOTSTRAP_SERVERS
              value: "{{ debezium_bootstrap_servers | default(kafka_bootstrap_servers) }}"
            - name: CONFIG_STORAGE_TOPIC
              value: "{{ debezium_config_storage_topic | default('cdc_connect_configs') }}"
            - name: OFFSET_STORAGE_TOPIC
              value: "{{ debezium_offset_storage_topic | default('cdc_connect_offsets') }}"
            - name: STATUS_STORAGE_TOPIC
              value: "{{ debezium_status_storage_topic | default('cdc_connect_status') }}"
            - name: CONFIG_STORAGE_REPLICATION_FACTOR
              value: "{{ debezium_config_storage_replication_factor | default('3') }}"
            - name: OFFSET_STORAGE_REPLICATION_FACTOR
              value: "{{ debezium_offset_storage_replication_factor | default('3') }}"
            - name: STATUS_STORAGE_REPLICATION_FACTOR
              value: "{{ debezium_status_storage_replication_factor | default('3') }}"
            - name: KEY_CONVERTER
              value: "{{ debezium_key_converter | default('io.confluent.connect.avro.AvroConverter') }}"
            - name: VALUE_CONVERTER
              value: "{{ debezium_value_converter | default('io.confluent.connect.avro.AvroConverter') }}"
            - name: CONNECT_KEY_CONVERTER_SCHEMA_REGISTRY_URL
              value: "{{ schema_registry_url }}"
            - name: CONNECT_VALUE_CONVERTER_SCHEMA_REGISTRY_URL
              value: "{{ schema_registry_url }}"
          resources:
            requests:
              cpu: {{ (debezium_resources.requests.cpu if (debezium_resources is defined and debezium_resources.requests is defined) else '150m') }}
              memory: {{ (debezium_resources.requests.memory if (debezium_resources is defined and debezium_resources.requests is defined) else '384Mi') }}
            limits:
              cpu: {{ (debezium_resources.limits.cpu if (debezium_resources is defined and debezium_resources.limits is defined) else '800m') }}
              memory: {{ (debezium_resources.limits.memory if (debezium_resources is defined and debezium_resources.limits is defined) else '768Mi') }}
          volumeMounts:
            - name: debezium-plugins
              mountPath: /kafka/connect/plugins
            - name: debezium-data
              mountPath: /kafka/data
      volumes:
        - name: debezium-plugins
          persistentVolumeClaim:
            claimName: {{ debezium_plugins_pvc_name | default('debezium-plugins-itp') }}
        - name: debezium-data
          persistentVolumeClaim:
            claimName: {{ debezium_data_pvc_name | default('debezium-data-itp') }}
