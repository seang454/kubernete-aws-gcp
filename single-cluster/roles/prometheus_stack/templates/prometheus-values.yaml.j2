# ==============================================================================
# kube-prometheus-stack Helm Values Template
# ==============================================================================

# Global settings
global:
  rbac:
    create: true

# Prometheus Operator Controller
prometheusOperator:
  enabled: true

# Prometheus Instance (StatefulSet)
prometheus:
  enabled: true
  prometheusSpec:
    secrets:
      - etcd-client-cert
    retention: "{{ prometheus_storage.retention | default('15d') }}"
    scrapeInterval: "{{ prometheus_scrape_interval | default('15s') }}"
    evaluationInterval: "{{ prometheus_evaluation_interval | default('15s') }}"
    enableAdminAPI: true
{% if prometheus_storage.storage_class.enabled | default(true) %}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: "{{ prometheus_storage.storage_class.name | default('longhorn') }}"
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: "{{ prometheus_storage.storage_class.size | default('15Gi') }}"
{% else %}
    storageSpec:
      emptyDir: {}
{% endif %}

# Alertmanager (StatefulSet)
alertmanager:
  enabled: true
  alertmanagerSpec:
    retention: "{{ alertmanager_retention | default('120h') }}"

# Grafana Core UI (Deployment)
grafana:
  enabled: true
  adminUser: "{{ grafana_admin_user | default('admin') }}"
  adminPassword: "{{ grafana_admin_password | default('PrometheusGrafanaPass2026!') }}"
  plugins:
    - grafana-opensearch-datasource
  sidecar:
    dashboards:
      enabled: true
      label: {{ grafana_sidecar_dashboards_label | default('grafana_dashboard') }}
      labelValue: "1"
      searchNamespace: ALL
    datasources:
      enabled: true
      label: {{ grafana_sidecar_datasources_label | default('grafana_datasource') }}
      labelValue: "1"
      searchNamespace: ALL
{% if enable_ingress | default(false) %}
  ingress:
    enabled: true
    ingressClassName: "{{ ingress_class_name | default('nginx') }}"
    hosts:
      - "{{ grafana_domain }}"
{% if enable_tls | default(false) %}
    tls:
      - secretName: grafana-tls
        hosts:
          - "{{ grafana_domain }}"
{% endif %}
{% endif %}

# Node Exporter (DaemonSet on every VM node)
nodeExporter:
  enabled: {{ enable_node_exporter | default(true) }}
  operatingSystems:
    linux:
      enabled: true

prometheus-node-exporter:
  priorityClassName: system-node-critical
  resources:
    requests:
      cpu: 10m
      memory: 20Mi
    limits:
      cpu: 100m
      memory: 64Mi

# kube-state-metrics (Deployment polling Kubernetes API)
kubeStateMetrics:
  enabled: {{ enable_kube_state_metrics | default(true) }}

# cAdvisor & kubelet scraping
kubelet:
  enabled: {{ enable_cadvisor | default(true) }}
  serviceMonitor:
    cAdvisor: true
    resource: true

kubeControllerManager:
  enabled: false

kubeScheduler:
  enabled: false

kubeProxy:
  enabled: false

# etcd Scraping (External Systemd Cluster with mTLS)
kubeEtcd:
  enabled: true
  endpoints:
{% for host in groups['k8s_control_plane'] | default([]) %}
    - {{ hostvars[host].internal_ip | default(hostvars[host].ansible_host) }}
{% endfor %}
{% if groups['k8s_control_plane'] is not defined %}
    - 10.0.0.1
    - 10.0.0.2
    - 10.0.0.3
{% endif %}
  service:
    enabled: true
    port: 2379
    targetPort: 2379
  serviceMonitor:
    enabled: true
    scheme: https
    insecureSkipVerify: false
    caFile: /etc/prometheus/secrets/etcd-client-cert/etcd-ca
    certFile: /etc/prometheus/secrets/etcd-client-cert/etcd-client
    keyFile: /etc/prometheus/secrets/etcd-client-cert/etcd-client-key

