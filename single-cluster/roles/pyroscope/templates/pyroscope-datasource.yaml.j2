apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-pyroscope
  namespace: "{{ k8s_monitoring_namespace }}"
  labels:
    {{ grafana_sidecar_datasources_label | default('grafana_datasource') }}: "1"
data:
  pyroscope-datasource.yaml: |-
    apiVersion: 1
    datasources:
      - name: Pyroscope
        type: grafana-pyroscope-datasource
        access: proxy
        url: {{ pyroscope_url }}
        isDefault: false
        jsonData:
          minStep: 15s
