# ==============================================================================
# loki-stack Helm Values Template
# ==============================================================================

loki:
  enabled: true
  isDefault: false
  image:
    tag: {{ loki_image_tag | default('3.3.0') }}
  config:
    existingSecret: loki-config
  readinessProbe:
    httpGet:
      path: /ready
      port: http-metrics
    initialDelaySeconds: 15
    periodSeconds: 10
    failureThreshold: 20
  livenessProbe:
    httpGet:
      path: /ready
      port: http-metrics
    initialDelaySeconds: 120
    periodSeconds: 15
    failureThreshold: 5
  persistence:
{% if loki_storage.storage_class.enabled | default(true) %}
    enabled: true
    storageClassName: "{{ loki_storage.storage_class.name | default('longhorn') }}"
    size: "{{ loki_storage.storage_class.size | default('15Gi') }}"
{% else %}
    enabled: false
{% endif %}

promtail:
  enabled: {{ 'false' if (enable_alloy | default(true)) else 'true' }}
  config:
    lokiAddress: "{{ loki_push_url }}"

fluent-bit:
  enabled: false

grafana:
  enabled: false  # We use Grafana deployed from kube-prometheus-stack
  sidecar:
    datasources:
      enabled: false

prometheus:
  enabled: false
