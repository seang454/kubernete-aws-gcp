---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ schema_registry_service_name | default('schema-registry-itp') }}-data
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ default_storage_class | default('longhorn') }}
  resources:
    requests:
      storage: {{ schema_registry_storage_size | default('2Gi') }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ schema_registry_service_name | default('schema-registry-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
spec:
  type: ClusterIP
  ports:
    - port: {{ schema_registry_port | default(8081) }}
      targetPort: {{ schema_registry_port | default(8081) }}
      name: http
  selector:
    app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ schema_registry_service_name | default('schema-registry-itp') }}
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ schema_registry_service_name | default('schema-registry-itp') }}
    spec:
      containers:
        - name: schema-registry
          image: {{ schema_registry_image | default('confluentinc/cp-schema-registry:7.8.0') }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{ schema_registry_port | default(8081) }}
              name: http
          env:
            - name: SCHEMA_REGISTRY_HOST_NAME
              value: "{{ schema_registry_service_name | default('schema-registry-itp') }}"
            - name: SCHEMA_REGISTRY_LISTENERS
              value: "http://0.0.0.0:{{ schema_registry_port | default(8081) }}"
            - name: SCHEMA_REGISTRY_DEBUG
              value: "{{ schema_registry_debug | default('true') }}"
            - name: SCHEMA_REGISTRY_KAFKASTORE_TOPIC
              value: "{{ schema_registry_topic | default('_schemas') }}"
            - name: SCHEMA_REGISTRY_KAFKASTORE_TOPIC_REPLICATION_FACTOR
              value: "{{ schema_registry_replication_factor | default('3') }}"
            - name: SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS
              value: "{{ schema_registry_bootstrap_servers | default(kafka_bootstrap_servers) }}"
          resources:
            requests:
              cpu: {{ (schema_registry_resources.requests.cpu if (schema_registry_resources is defined and schema_registry_resources.requests is defined) else '100m') }}
              memory: {{ (schema_registry_resources.requests.memory if (schema_registry_resources is defined and schema_registry_resources.requests is defined) else '256Mi') }}
            limits:
              cpu: {{ (schema_registry_resources.limits.cpu if (schema_registry_resources is defined and schema_registry_resources.limits is defined) else '500m') }}
              memory: {{ (schema_registry_resources.limits.memory if (schema_registry_resources is defined and schema_registry_resources.limits is defined) else '512Mi') }}
          volumeMounts:
            - name: schema-registry-data
              mountPath: /etc/schema-registry/data
      volumes:
        - name: schema-registry-data
          persistentVolumeClaim:
            claimName: {{ schema_registry_service_name | default('schema-registry-itp') }}-data
