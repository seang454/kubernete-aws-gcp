apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: jaeger-httproute
  namespace: {{ k8s_monitoring_namespace | default('monitoring') }}
  labels:
    app.kubernetes.io/name: jaeger
spec:
  parentRefs:
    - name: {{ traefik_gateway_name | default('traefik-gateway') }}
      namespace: {{ traefik_namespace | default('traefik') }}
  hostnames:
    - "{{ jaeger_domain | default('jaeger.seang.shop') }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ jaeger_service_name | default('jaeger') }}
          port: {{ jaeger_query_port | default(16686) }}
