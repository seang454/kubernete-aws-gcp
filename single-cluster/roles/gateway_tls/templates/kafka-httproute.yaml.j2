apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: kafka-ui-httproute
  namespace: {{ kafka_namespace | default('kafka') }}
  labels:
    app.kubernetes.io/name: {{ kafka_ui_service_name | default('kafka-ui-itp') }}
    app.kubernetes.io/part-of: kafka-cluster
spec:
  parentRefs:
    - name: {{ traefik_gateway_name | default('traefik-gateway') }}
      namespace: {{ traefik_namespace | default('traefik') }}
  hostnames:
    - "{{ kafka_ui_domain | default('kafka.seang.shop') }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ kafka_ui_service_name | default('kafka-ui-itp') }}
          port: {{ kafka_ui_port | default(8080) }}
