apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudflared-config
  namespace: {{ traefik_namespace | default('traefik') }}
data:
  config.yaml: |
    tunnel: {{ cloudflare_tunnel_id }}
    credentials-file: /etc/cloudflared/creds/credentials.json
    metrics: 0.0.0.0:2000
    no-autoupdate: true

    ingress:
      # Grafana Dashboard route
      - hostname: "{{ grafana_domain | default('grafana.seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # Prometheus UI route
      - hostname: "{{ prometheus_domain | default('prometheus.seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # OpenSearch Dashboard route
      - hostname: "{{ opensearch_domain | default('opensearch.seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # Jaeger UI route
      - hostname: "{{ jaeger_domain | default('jaeger.seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # ========================================================================
      # CRITICAL: Wildcard catch-all for all remaining cluster services
      # Because this rule (*.seang.shop) forwards to Traefik, you NEVER need
      # to update this file or restart the pod when deploying a new service
      # (e.g., kafka.seang.shop). Traefik Gateway API handles the routing!
      # ========================================================================
      - hostname: "*.{{ base_domain | default('seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # Apex domain
      - hostname: "{{ base_domain | default('seang.shop') }}"
        service: https://traefik.{{ traefik_namespace | default('traefik') }}.svc.{{ k8s_cluster_domain | default('k8scluster') }}:443
        originRequest:
          originServerName: "{{ base_domain | default('seang.shop') }}"

      # Mandatory catch-all 404 rule
      - service: http_status:404
