apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ cloudflare_cluster_issuer_name | default('letsencrypt-cloudflare') }}
spec:
  acme:
    server: {{ acme_server_url | default('https://acme-v02.api.letsencrypt.org/directory') }}
    email: {{ acme_admin_email }}
    privateKeySecretRef:
      name: letsencrypt-cloudflare-account-key
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token-secret
              key: api-token
