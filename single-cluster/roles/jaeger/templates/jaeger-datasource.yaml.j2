apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-jaeger
  namespace: "{{ k8s_monitoring_namespace }}"
  labels:
    {{ grafana_sidecar_datasources_label | default('grafana_datasource') }}: "1"
data:
  jaeger-datasource.yaml: |-
    apiVersion: 1
    datasources:
      - name: Jaeger
        type: jaeger
        access: proxy
        url: {{ jaeger_query_url }}
        isDefault: false
