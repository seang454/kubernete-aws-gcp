apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jaeger_service_name | default('jaeger') }}
  namespace: "{{ k8s_monitoring_namespace }}"
  labels:
    app.kubernetes.io/name: {{ jaeger_service_name | default('jaeger') }}
spec:
  replicas: {{ jaeger_replicas | default(1) }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ jaeger_service_name | default('jaeger') }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ jaeger_service_name | default('jaeger') }}
    spec:
      containers:
        - name: jaeger
          image: {{ jaeger_image | default('jaegertracing/all-in-one:1.64.0') }}
          imagePullPolicy: IfNotPresent
          env:
            - name: COLLECTOR_OTLP_ENABLED
              value: "true"
            - name: SPAN_STORAGE_TYPE
              value: "{{ jaeger_storage_type | default('memory') }}"
            - name: MEMORY_MAX_TRACES
              value: "{{ jaeger_memory_max_traces | default('50000') }}"
          ports:
            - name: query-http
              containerPort: {{ jaeger_query_port | default(16686) }}
              protocol: TCP
            - name: otlp-grpc
              containerPort: {{ jaeger_otlp_grpc_port | default(4317) }}
              protocol: TCP
            - name: otlp-http
              containerPort: {{ jaeger_otlp_http_port | default(4318) }}
              protocol: TCP
          resources:
            requests:
              cpu: {{ (jaeger_resources.requests.cpu if (jaeger_resources is defined and jaeger_resources.requests is defined) else '100m') }}
              memory: {{ (jaeger_resources.requests.memory if (jaeger_resources is defined and jaeger_resources.requests is defined) else '256Mi') }}
            limits:
              cpu: {{ (jaeger_resources.limits.cpu if (jaeger_resources is defined and jaeger_resources.limits is defined) else '500m') }}
              memory: {{ (jaeger_resources.limits.memory if (jaeger_resources is defined and jaeger_resources.limits is defined) else '1Gi') }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ jaeger_service_name | default('jaeger') }}
  namespace: "{{ k8s_monitoring_namespace }}"
  labels:
    app.kubernetes.io/name: {{ jaeger_service_name | default('jaeger') }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ jaeger_service_name | default('jaeger') }}
  ports:
    - name: query-http
      port: {{ jaeger_query_port | default(16686) }}
      targetPort: {{ jaeger_query_port | default(16686) }}
    - name: otlp-grpc
      port: {{ jaeger_otlp_grpc_port | default(4317) }}
      targetPort: {{ jaeger_otlp_grpc_port | default(4317) }}
    - name: otlp-http
      port: {{ jaeger_otlp_http_port | default(4318) }}
      targetPort: {{ jaeger_otlp_http_port | default(4318) }}
{% if enable_ingress | default(false) %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: jaeger-query
  namespace: "{{ k8s_monitoring_namespace }}"
  annotations:
    kubernetes.io/ingress.class: "{{ ingress_class_name | default('nginx') }}"
spec:
  ingressClassName: "{{ ingress_class_name | default('nginx') }}"
  rules:
    - host: "{{ jaeger_domain | default('jaeger.seang.shop') }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ jaeger_service_name | default('jaeger') }}
                port:
                  number: {{ jaeger_query_port | default(16686) }}
{% endif %}
