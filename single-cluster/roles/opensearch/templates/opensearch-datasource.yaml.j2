apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-opensearch
  namespace: "{{ k8s_monitoring_namespace }}"
  labels:
    {{ grafana_sidecar_datasources_label | default('grafana_datasource') }}: "1"
data:
  opensearch-datasource.yaml: |-
    apiVersion: 1
    datasources:
      - name: OpenSearch
        type: elasticsearch
        access: proxy
        url: {{ opensearch_url }}
        isDefault: false
        jsonData:
          esVersion: "7.10.0"
          timeField: "@timestamp"
          interval: "Daily"
          logMessageField: "log"
          logLevelField: "level"
