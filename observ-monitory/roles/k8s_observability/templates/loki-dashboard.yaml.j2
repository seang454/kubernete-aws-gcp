apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-logs-dashboard
  namespace: {{ k8s_monitoring_namespace }}
  labels:
    grafana_dashboard: "1"
data:
  loki-metrics.json: |
    {
      "annotations": {"list": []},
      "editable": true,
      "title": "Grafana Loki Log Engine Overview",
      "tags": ["loki", "logs"],
      "panels": [
        {
          "title": "Log Lines Ingestion Rate",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
          "targets": [{"expr": "sum(rate(loki_distributor_lines_received_total[5m])) or vector(0)", "legendFormat": "Lines/sec"}]
        },
        {
          "title": "Log Ingestion Bytes Rate",
          "type": "timeseries",
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
          "targets": [{"expr": "sum(rate(loki_distributor_bytes_received_total[5m])) or vector(0)", "legendFormat": "Bytes/sec"}]
        }
      ],
      "schemaVersion": 38
    }
